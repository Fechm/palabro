# Copia a .dev.vars (ignorado por git) y rellena.
# En produccion estos valores van con: wrangler secret put <NOMBRE>

# Supabase — panel del proyecto > Settings > API
SUPABASE_URL="https://xxxxxxxxxxx.supabase.co"
SUPABASE_ANON_KEY="eyJ..."
# service_role: NUNCA la expongas al cliente ni la commitees
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
# Settings > API > JWT Settings > JWT Secret (para verificar tokens en el Worker)
SUPABASE_JWT_SECRET="..."

# Google AI Studio — https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY="AIza..."
