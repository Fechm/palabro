# Único archivo de entorno del proyecto. Cópialo a .env (ignorado por git).
# Lo leen Vite (cliente), wrangler (Worker en local) y los scripts del corpus.
# En producción los secretos del Worker van con: wrangler secret put <NOMBRE>

# --- Cliente: Vite solo expone al bundle las variables con prefijo VITE_ ---
# La anon key es pública POR DISEÑO: lo que protege los datos es la RLS.
VITE_SUPABASE_URL="https://ckjoklnmedodnrrqzqpk.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJ..."

# --- Worker y corpus: NUNCA con prefijo VITE_ ---
SUPABASE_URL="https://ckjoklnmedodnrrqzqpk.supabase.co"
# Supabase > Project Settings > API Keys > service_role (o una secret key sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=""
# Google AI Studio — https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=""
# Opcional: fija un modelo concreto en vez del alias gemini-flash-latest
# GEMINI_MODEL=""
# Código que piden las cuentas nuevas. Para cerrar el registro, cámbialo.
INVITE_CODE=""
